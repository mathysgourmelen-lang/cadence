    "electron": "^38.8.6",
    "electron-builder": "^26.0.20",
    "electron-vite": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
